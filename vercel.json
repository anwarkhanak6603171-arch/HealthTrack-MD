{
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(index.html)?",
      "dest": "main.py"
    },
    {
      "src": "/login",
      "dest": "main.py"
    },
    {
      "src": "/register",
      "dest": "main.py"
    },
    {
      "src": "/patients(.*)",
      "dest": "main.py"
    },
    {
      "src": "/token",
      "dest": "main.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "main.py"
    }
  ]
}
